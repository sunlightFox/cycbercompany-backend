# PowerShell:
#   $env:EDGEFN_API_KEY="sk-..."
#
# The application reads the model key from the environment. Do not commit real keys.
EDGEFN_API_KEY=
EDGEFN_BASE_URL=https://api.edgefn.net/v1
EDGEFN_MODEL=MiniMax-M3

# Tavily-powered web search is picked up automatically when this key is present.
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search

# Required by deploy/docker-compose.production.yml. Keep real values only in
# the server-side .env file, never in source control.
POSTGRES_DB=cycbercompany
POSTGRES_USER=cycbercompany
POSTGRES_PASSWORD=

# MCP credentials are deployment secrets. For each MCP connection, put the
# real value here (or in the service EnvironmentFile) and use an env:NAME
# reference in that connection's `env` map. Do not commit real credentials.
# EXAMPLE_SERVICE_TOKEN=
