FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY . .
RUN chmod +x gradlew && ./gradlew :cycbercompany-node-java:installDist --no-daemon

FROM mcr.microsoft.com/playwright/java:v1.61.0-noble
WORKDIR /app
COPY --from=build /src/cycbercompany-node-java/build/install/cycbercompany-node-java/ ./
RUN mkdir -p /workspace /root/.cycbercompany-node/data
VOLUME ["/workspace", "/root/.cycbercompany-node"]
CMD ["./bin/cycbercompany-node-java", "start"]
